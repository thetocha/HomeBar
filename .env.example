# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF

# Your Telegram numeric user id (whitelist). Everyone else is a guest.
# Find it via @userinfobot or similar.
BARTENDER_TELEGRAM_ID=123456789

# Public HTTPS URL of the Mini App (Cloudflare Tunnel, ngrok, or your host).
# Telegram will not load http://localhost. Example: https://abc.trycloudflare.com
WEBAPP_URL=https://your-public-host.example

# Optional. When set, requests without Telegram initData are treated as this user
# so you can click through guest vs bartender in a normal browser.
# Set it equal to BARTENDER_TELEGRAM_ID to browse as bartender, or any other id as guest.
# The frontend also sends X-Dev-Telegram-User-Id when you use the local "view as" toggle.
DEV_TELEGRAM_USER_ID=123456789
