# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF

# Your Telegram numeric user id (whitelist). Everyone else is a guest.
# Find it via @userinfobot or similar.
BARTENDER_TELEGRAM_ID=123456789

# Public HTTPS URL of the Mini App. Leave this as-is when AUTO_TUNNEL=1:
# the backend starts a tunnel and rewrites this value, then updates the bot menu button.
WEBAPP_URL=https://your-public-host.example

# Keep a tunnel running inside the backend so the phone link does not go stale.
# Set to 0 only if WEBAPP_URL is a stable hostname you manage yourself.
AUTO_TUNNEL=1

# Tunnel backend when AUTO_TUNNEL=1: auto (cloudflared if installed, else localhost.run),
# cloudflare, or localhost. Cloudflare quick tunnels are more stable for Cloud Agents.
TUNNEL_PROVIDER=auto

# Bot updates: auto uses webhooks on Cloud Agents (recommended). Use polling only
# when exactly one local dev process runs — never two servers with the same BOT_TOKEN.
BOT_UPDATES_MODE=auto

# Optional. When set, requests without Telegram initData are treated as this user
# so you can click through guest vs bartender in a normal browser.
# Set it equal to BARTENDER_TELEGRAM_ID to browse as bartender, or any other id as guest.
# The frontend also sends X-Dev-Telegram-User-Id when you use the local "view as" toggle.
DEV_TELEGRAM_USER_ID=123456789
